BACKEND_URL=https://aznxt-fx-ts-backend-server-1.onrender.com
BACKEND_ALLOWED_HOSTS=
DEPLOY_ENV=development
GIT_COMMIT_SHA=
NEXT_PUBLIC_WS_URL=https://mock-ws-chart.onrender.com
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://my.movementmarkets.com

# Runtime kill switch, read on every request: enabled | close-only | halted.
# Enable only after FIX deployment and end-to-end staging acceptance.
TRADING_MODE=halted
# Comma-separated symbols that cannot receive new orders (closing stays possible), e.g. BTCUSD,ETHUSD
HALTED_SYMBOLS=
# Legacy: used only when TRADING_MODE is unset ("true" = enabled, anything else = halted).
TRADING_ENABLED=false
# Legacy build-time UI flag. The UI now reads /api/trading/status at runtime; keep false.
NEXT_PUBLIC_TRADING_ENABLED=false
